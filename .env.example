# ── ARAM environment ──
# Copy to `.env.local` (git-ignored) and fill in from your Supabase project.
# Create the Supabase project in the ap-south-1 (Mumbai) region for India data residency.
#
# Only the PUBLIC anon key belongs here — it is safe to ship to the browser because
# Row-Level Security + SECURITY DEFINER RPCs enforce all access. NEVER put the
# service_role key in this file or in any client code.
#
# If these are left blank the app runs in local MOCK mode (UI review without a backend).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
